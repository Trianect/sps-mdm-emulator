<?xml version="1.0" encoding="utf-8"?>
<!-- A managed configuration row: key, "differs from default" dot and the current value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal">

    <TextView
            android:id="@+id/restriction_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    <ImageView
            android:id="@+id/modified_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/modified_dot"
            android:contentDescription="@string/differs_from_default"
            android:visibility="gone"/>

    <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">

        <Spinner
                android:id="@+id/restriction_value_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:visibility="gone"/>

        <!-- Shrinks to fit; if it still does not fit, only the last part is shown. -->
        <TextView
                android:id="@+id/restriction_value_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:ellipsize="start"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textAppearance="?android:attr/textAppearanceMedium"/>
    </FrameLayout>
</LinearLayout>
